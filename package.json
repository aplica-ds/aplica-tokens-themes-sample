{
  "name": "@aplica/tokens-themes-sample",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Aplica Design theme sample (v1.0): JSON files ready to import into Tokens Studio as a starter template. The dist/ folder holds the reference token output for this repository.",
  "homepage": "https://aplica.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aplica-ds/aplica-tokens-themes-sample.git"
  },
