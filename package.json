    "./dist/*": "./dist/*",
    "./utils/*": "./utils/*"
  },
  "devDependencies": {
    "@aplica/aplica-theme-engine": "^3.3.2"
  },
  "scripts": {
    "themes:clean-figma": "node utils/clean-themes-figma-references.mjs"
  }
